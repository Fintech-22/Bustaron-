# ---------------------------------------------------------------------------
# BUSTARON environment variables
# Copy this file to .env.local and fill in the values you need.
# Never commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Mapbox PUBLIC token (pk.*). Leave unset/blank to use the offline SVG map.
# Read in src/services/mapboxConfig.ts. Never put a secret (sk.*) token here —
# anything with a VITE_ prefix is inlined into the shipped client bundle.
VITE_MAPBOX_TOKEN=pk.your-public-token-here

# Base URL of the M3 FastAPI backend. Defaults to http://127.0.0.1:8000 when
# unset. Read in src/services/dataBackend.ts.
VITE_M3_API_URL=http://127.0.0.1:8000

# Server-side only (read by server/main.py, NOT exposed to the client).
# Directory holding state.json. Defaults to <repo>/server/data.
BUSTARON_DATA_DIR=

# ---------------------------------------------------------------------------
# 3-of-3 Proof-of-Authority consensus (PRD §9, FR-B5) — server-side only.
# Read by server/authorities.py, NOT exposed to the client.
#
# The chain is co-signed by three authorities: node:admin, node:agent_a and
# node:agent_b. Each block carries a `sigs` map keyed by those ids.
#
# Leave all three *_SEED vars UNSET in dev: each authority's Ed25519 seed is then
# DERIVED deterministically from a fixed salt, so a dev chain is reproducible from
# code alone (nothing secret to commit or manage). The server logs a loud warning
# whenever it falls back to these public dev keys.
#
# Set BUSTARON_ENV=production to REQUIRE explicit seeds. In production every
# authority seed MUST be provided — each a 64-hex-character (32-byte) value — or the
# server refuses to start with AuthorityConfigError (there is NO dev-key fallback).
# Rotate a seed to rotate that authority's key; an unrotated set of the other two is
# NOT a valid quorum. Generate one per authority with
# `python -c "import os;print(os.urandom(32).hex())"` and keep it in a secret
# manager — NOT in this file.
BUSTARON_ENV=
BUSTARON_AUTHORITY_NODE_ADMIN_SEED=
BUSTARON_AUTHORITY_NODE_AGENT_A_SEED=
BUSTARON_AUTHORITY_NODE_AGENT_B_SEED=

